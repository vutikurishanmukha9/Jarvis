# ==============================================================================
# J.A.R.V.I.S. Super-Intelligence Platform — Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your desired credentials:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE REASONING ENGINE & LLM PROVIDERS
# ------------------------------------------------------------------------------
# Primary AI Provider: "OpenRouter", "OpenAI", or "Custom"
JARVIS_PROVIDER=OpenRouter

# OpenRouter API Key (RECOMMENDED - Unified access to GPT-4o, Claude 3.5 Sonnet, Gemini 2.0, DeepSeek V3/R1, Llama 3.3)
# Obtain at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key (Direct access to OpenAI models and optional cloud Whisper/TTS)
# Obtain at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Active Reasoning Model Identifier
# Examples: openai/gpt-4o, anthropic/claude-3.5-sonnet, deepseek/deepseek-chat, google/gemini-2.0-flash-001
JARVIS_MODEL=openai/gpt-4o

# Custom OpenAI-Compatible Base URL (Optional: for Local vLLM, Ollama, LM Studio, Groq)
# JARVIS_BASE_URL=http://localhost:11434/v1

# Alternative Direct LLM Provider Keys (Optional)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# FIREWORKS_API_KEY=your_fireworks_api_key_here

# ------------------------------------------------------------------------------
# 2. MESSAGING GATEWAYS & BOT BRIDGES (HERMES GATEWAY MATRIX)
# ------------------------------------------------------------------------------
# Telegram Gateway Bot (Supports voice notes, text directives, deliverable downloads)
# Create a bot with @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=123456789,987654321
# TELEGRAM_HOME_CHANNEL=
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram

# Discord Bot Integration (Optional)
# DISCORD_BOT_TOKEN=your_discord_bot_token_here
# DISCORD_ALLOWED_USERS=your_discord_user_id
# DISCORD_HOME_CHANNEL=your_channel_id

# Slack Bot Integration (Optional)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALLOWED_USERS=U12345678

# WhatsApp Integration (Optional — Baileys Bridge)
# WHATSAPP_ENABLED=false
# WHATSAPP_ALLOWED_USERS=15551234567

# Email Gateway (Optional — IMAP/SMTP automated inbox triage & dispatch)
# EMAIL_ADDRESS=jarvis@yourdomain.com
# EMAIL_PASSWORD=your_app_password
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_ALLOWED_USERS=boss@yourdomain.com

# Microsoft Teams Integration (Optional)
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=
# TEAMS_TENANT_ID=

# Google Chat Integration (Optional)
# GOOGLE_CHAT_PROJECT_ID=
# GOOGLE_CHAT_SUBSCRIPTION_NAME=

# ------------------------------------------------------------------------------
# 3. WEB RESEARCH & SCRAPING MATRIX (3-TIER ADAPTIVE)
# ------------------------------------------------------------------------------
# Tier 1: DuckDuckGo, Wikipedia, Scrapling (Anti-Detect HTTP) -> 100% FREE, NO KEY NEEDED
# Tier 2: Crawl4AI (Local Headless Playwright Browser)       -> 100% FREE, NO KEY NEEDED
# Tier 3: Cloud Web Crawling / Search (Optional Fallbacks)
# FIRECRAWL_API_KEY=fc-your-api-key-here
# EXA_API_KEY=your_exa_api_key_here
# PARALLEL_API_KEY=your_parallel_api_key_here

# Anti-Detect Browser Path (Optional: auto-detects Chrome, Edge, or Brave)
# BRAVE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe

# Cloud Browserbase (Optional: remote stealth browser execution)
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# BROWSERBASE_PROXIES=true

# ------------------------------------------------------------------------------
# 4. VOICE STUDIO & ACOUSTICS (100% LOCAL BY DEFAULT)
# ------------------------------------------------------------------------------
# Local Speech-to-Text: faster-whisper (tiny, base, small, medium, large-v3) -> NO KEY NEEDED
# Local Text-to-Speech: Windows SAPI5 / Kokoro-ONNX                         -> NO KEY NEEDED
# Wake Word Engine: Acoustic keyword spotter                                 -> NO KEY NEEDED

# Optional Cloud Audio API Overrides:
# VOICE_TOOLS_OPENAI_KEY=your_openai_api_key_here
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ------------------------------------------------------------------------------
# 5. COMPUTER VISION & OBJECT DETECTION (100% LOCAL BY DEFAULT)
# ------------------------------------------------------------------------------
# YOLOv8 object detection uses local yolov8n.pt weights                      -> NO KEY NEEDED
# OCR text extraction uses local EasyOCR                                     -> NO KEY NEEDED
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.25

# ------------------------------------------------------------------------------
# 6. DOCUMENT INTELLIGENCE & ATS RESUME ENGINE (100% LOCAL BY DEFAULT)
# ------------------------------------------------------------------------------
# Docling / MinerU document parser runs locally                              -> NO KEY NEEDED
# Sentence-Transformers (all-MiniLM-L6-v2) embeddings run locally           -> NO KEY NEEDED
# Full-Text Search FTS5 & SQLite WAL memory store runs locally in logs/      -> NO KEY NEEDED

# ------------------------------------------------------------------------------
# 7. DEVELOPMENT & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Terminal execution timeout in seconds
TERMINAL_TIMEOUT=60
LOG_LEVEL=INFO
